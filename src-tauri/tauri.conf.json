{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Prompt",
  "version": "0.7.1",
  "identifier": "com.voiceprompt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Prompt",
        "width": 280,
        "height": 260,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "alwaysOnTop": true,
        "visible": true,
        "decorations": false,
        "backgroundColor": "#f8f9f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "runtime/*.dll",
      "runtime/whisper-server.exe",
      "runtime/vulkan/*.exe",
      "runtime/ggml-*.bin",
      "runtime/model.json",
      "runtime/LICENSE*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "compression": "zlib"
      }
    }
  }
}
