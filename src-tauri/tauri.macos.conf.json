{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Voice Prompt",
        "width": 240,
        "height": 224,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "alwaysOnTop": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": ["runtime/whisper-server", "runtime/LICENSE*"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
